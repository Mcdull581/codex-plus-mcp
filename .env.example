# Optional: custom directory storing accounts.json, accounts/<id>/auth.json, and deepseek.json
# Defaults to ~/.codex-plus-mcp when installed via setup wizard
# CODEX_BRIDGE_HOME=

# Optional: DeepSeek API key for deepseek_ask and deepseek_search tools
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
